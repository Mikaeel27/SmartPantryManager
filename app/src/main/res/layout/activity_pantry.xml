<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pantryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7F2">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#24543B"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/textPantrySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your saved ingredients"
        android:textSize="16sp"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <ListView
        android:id="@+id/listPantryIngredients"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#D8DED5"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/textEmptyPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your pantry is empty. Add an ingredient to get started."
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnPantryAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnPantryBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        android:layout_marginTop="8dp" />

</LinearLayout>