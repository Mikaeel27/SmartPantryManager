<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recipesMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1B4332"
        android:gravity="center"
        android:padding="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipes you can make using your pantry ingredients."
        android:textSize="15sp"
        android:textColor="#555555"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/textRecipeInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Only recipes with all required ingredients in sufficient quantities should be suggested."
        android:textSize="14sp"
        android:textColor="#333333"
        android:padding="12dp"
        android:background="#E3F2E8"
        android:layout_marginBottom="12dp" />

    <ListView
        android:id="@+id/listSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp"
        android:padding="4dp" />

    <Button
        android:id="@+id/btnRecipesBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        android:layout_marginTop="12dp" />

</LinearLayout>