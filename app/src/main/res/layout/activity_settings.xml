<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1B4332"
            android:gravity="center"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Pantry Manager"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1B4332"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your pantry and discover recipes using the ingredients you have available."
            android:textSize="16sp"
            android:textColor="#555555"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Matching"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B4332"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipes are suggested only when all required ingredients are available in sufficient quantities and compatible units."
            android:textSize="15sp"
            android:textColor="#333333"
            android:background="#E3F2E8"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Supported Units"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B4332"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kilograms (kg), grams (g), litres (L), millilitres (ml), pieces and packets."
            android:textSize="15sp"
            android:textColor="#333333"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/btnSettingsBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Home" />

    </LinearLayout>

</ScrollView>